# ========================================
# A4A Learn Backend Configuration
# ========================================

APP_NAME=A4A Learn
APP_VERSION=1.0.0
APP_ENV=development

HOST=0.0.0.0
PORT=8000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/a4alearn

# JWT
SECRET_KEY=YOUR_SECRET_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Logging
LOG_LEVEL=INFO

# --------------------------------------------------
# Governed Web Retrieval
# --------------------------------------------------
A4A_WEB_SEARCH_ENABLED=false
A4A_WEB_FALLBACK_ONLY=true
A4A_WEB_MAX_RESULTS=3
A4A_WEB_TIMEOUT_SECONDS=8
A4A_WEB_ALLOWED_DOMAINS=docs.python.org,scikit-learn.org,pytorch.org,tensorflow.org