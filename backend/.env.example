APP_NAME=A4A Learn
APP_VERSION=1.0.0
APP_ENV=development

HOST=0.0.0.0
PORT=8000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/a4alearn

# JWT
SECRET_KEY=YOUR_SECRET_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Logging
LOG_LEVEL=INFO